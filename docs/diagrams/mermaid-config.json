    "fontSize": "18px",
    "primaryColor": "#edf3fb",
    "primaryTextColor": "#172b4d",
    "primaryBorderColor": "#7395c7",
    "lineColor": "#536985",
    "secondaryColor": "#f0f7f5",
    "tertiaryColor": "#f8fafc",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#b8c9df",
    "actorBkg": "#edf3fb",
    "actorBorder": "#7395c7",
    "actorTextColor": "#172b4d",
    "signalColor": "#536985",
