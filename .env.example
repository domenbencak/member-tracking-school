# Run npm run school:env to generate a private .env with random credentials.
# This example contains no usable passwords or authentication secret.
SCHOOL_DB_PASSWORD=
DATABASE_URL=postgresql://member_tracking_school:SET_BY_SCHOOL_ENV@127.0.0.1:5433/member_tracking_school
DIRECT_URL=postgresql://member_tracking_school:SET_BY_SCHOOL_ENV@127.0.0.1:5433/member_tracking_school
AUTH_SECRET=
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=
SAMPLE_USER_EMAIL=user@example.test
SAMPLE_USER_PASSWORD=
NEXT_PUBLIC_ORGANIZATION_NAME=Evidenca članov — šolski projekt
DATA_CONTROLLER_NAME=Šolski projekt — izmišljeni podatki
DATA_RETENTION_NOTICE=Podatki so izmišljeni in se uporabljajo samo za šolsko predstavitev.
MAX_IMPORT_FILE_SIZE_MB=10
MAX_IMPORT_ROWS=50000
NEXTAUTH_URL=http://localhost:3001
