{
  "name": "member-tracking-school",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "school:env": "node scripts/setup-school.mjs",
    "school:db": "docker compose up -d --wait",
    "school:setup": "npm run school:env && npm run school:db && npm run db:deploy && npm run db:seed",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "sample:xlsx": "tsx scripts/generate-sample-xlsx.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@tanstack/react-table": "8.21.3",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "lucide-react": "0.536.0",
    "next": "16.2.12",
    "next-auth": "4.24.15",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.62.0",
    "recharts": "3.1.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.34.0",
    "eslint-config-next": "16.2.12",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.0"
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "valibot": "1.4.2"
  }
}
